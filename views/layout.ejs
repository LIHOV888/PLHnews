  <footer class="text-white text-center py-4 mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-4">
          <h5>Hnews</h5>
          <p>Your trusted source for breaking news and in-depth reporting.</p>
        </div>
        <div class="col-md-4">
          <h5>Quick Links</h5>
          <ul class="list-unstyled">
            <li><a href="/about" class="text-white text-decoration-none">About Us</a></li>
            <li><a href="/contact" class="text-white text-decoration-none">Contact</a></li>
            <li><a href="/privacy" class="text-white text-decoration-none">Privacy Policy</a></li>
            <li><a href="/terms" class="text-white text-decoration-none">Terms of Service</a></li>
