        </div>
      </div>
      <hr class="my-4">
      <p>&copy; 2025 Hnews. All rights reserved.</p>
    </div>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Socket.io -->
  <script src="/socket.io/socket.io.js"></script>

  <!-- Custom JS for dropdown hover -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'));
      const dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
        return new bootstrap.Dropdown(dropdownToggleEl);
      });

      // Add hover functionality to categories dropdown
      const categoriesDropdown = document.getElementById('navbarDropdown');
      const dropdownMenu = categoriesDropdown.nextElementSibling;

      categoriesDropdown.addEventListener('mouseenter', function() {
        const dropdown = bootstrap.Dropdown.getOrCreateInstance(this);
        dropdown.show();
      });

      categoriesDropdown.parentElement.addEventListener('mouseleave', function() {
        const dropdown = bootstrap.Dropdown.getOrCreateInstance(categoriesDropdown);
        dropdown.hide();
      });

      // Socket.io connection
      const socket = io();

      socket.on('connect', function() {
        console.log('Connected to server');
      });

      socket.on('disconnect', function() {
        console.log('Disconnected from server');
      });

      // Listen for article updates
      socket.on('article update', function(data) {
        console.log('Article update:', data);
        // Refresh page or update UI as needed
      });

      // Listen for comment updates
      socket.on('comment update', function(data) {
        console.log('Comment update:', data);
        // Refresh comments or update UI as needed
      });

        // Comments and ratings functionality for article pages
      if (document.getElementById('comment-form')) {
        const commentForm = document.getElementById('comment-form');
        const commentsList = document.getElementById('comments-list');
        const articleId = window.articleId || window.location.pathname.split('/').pop();

        // Load comments
        loadComments();

        // Handle comment form submission
        commentForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          const content = document.getElementById('comment-content').value;

          try {
            const response = await fetch('/api/comments', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              credentials: 'same-origin',
              body: JSON.stringify({
                content: content,
                articleId: articleId
              })
            });

            if (response.ok) {
              document.getElementById('comment-content').value = '';
              loadComments();
              socket.emit('new comment', { articleId: articleId });
            } else {
              alert('Failed to post comment');
            }
          } catch (error) {
            console.error('Error posting comment:', error);
            alert('Error posting comment');
          }
        });

        async function loadComments() {
          try {
            const response = await fetch(`/api/comments/${articleId}`, {
              credentials: 'same-origin'
            });
            const comments = await response.json();

            // Get current user info from a global variable set by EJS
            const currentUser = window.currentUser;

            commentsList.innerHTML = comments.map(comment => {
              const canDelete = currentUser &&
                               (comment.author._id === currentUser._id ||
                                currentUser.role === 'admin');

              return `
                <div class="comment mb-3 p-3 border rounded">
                  <div class="comment-header d-flex justify-content-between align-items-start">
                    <strong>${comment.author.username}</strong>
                    <div class="d-flex align-items-center">
                      <small class="text-muted me-2">${new Date(comment.createdAt).toLocaleDateString()}</small>
                      ${canDelete ? `<button class="btn btn-sm btn-outline-danger delete-comment" data-comment-id="${comment._id}">
                        <i class="fas fa-trash"></i>
                      </button>` : ''}
                    </div>
                  </div>
                  <div class="comment-content mt-2">
                    ${comment.content}
                  </div>
                </div>
              `;
            }).join('');

            // Add event listeners for delete buttons
            document.querySelectorAll('.delete-comment').forEach(button => {
              button.addEventListener('click', async function() {
                const commentId = this.getAttribute('data-comment-id');
                if (confirm('Are you sure you want to delete this comment?')) {
                  try {
                    const response = await fetch(`/api/comments/${commentId}`, {
                      method: 'DELETE',
                      credentials: 'same-origin'
                    });

                    if (response.ok) {
                      loadComments(); // Reload comments after deletion
                      socket.emit('comment deleted', { articleId: articleId });
                    } else {
                      alert('Failed to delete comment');
                    }
                  } catch (error) {
                    console.error('Error deleting comment:', error);
                    alert('Error deleting comment');
                  }
                }
              });
            });
          } catch (error) {
            console.error('Error loading comments:', error);
          }
        }
      }


    });
  </script>
</body>
</html>
