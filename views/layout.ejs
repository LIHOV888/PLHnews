              <li><a class="dropdown-item" href="/category/Crime">Crime</a></li>
              <li><a class="dropdown-item" href="/category/Weather">Weather</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/">All News</a></li>
            </ul>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/category/Politics">World</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/category/Politics">U.S.</a>
          </li>
          <li class="nav-item">
