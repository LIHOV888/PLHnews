<div class="container">
  <div class="row">
    <div class="col-lg-8">
      <!-- Search Results -->
      <section class="search-results mb-5">
        <h2 class="section-title">Search Results<% if (query) { %> for "<%= query %>"<% } %></h2>

        <% if (results && results.length > 0) { %>
          <% results.forEach(article => { %>
            <div class="news-item mb-4">
              <div class="row">
                <div class="col-md-4">
                  <a href="/article/<%= article._id %>">
                    <img src="<%= article.image %>" alt="<%= article.title %>" class="news-image">
                  </a>
                </div>
                <div class="col-md-8">
                  <h3 class="news-title"><a href="/article/<%= article._id %>"><%= article.title %></a></h3>
                  <p class="news-summary"><%= article.summary %></p>
                  <div class="news-meta">
                    <small class="text-muted views-count"><%= article.date.toDateString() %> | <%= article.views %> views</small>
                    <a href="/article/<%= article._id %>" class="read-more">Read More</a>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else if (query) { %>
          <div class="text-center">
            <p>No results found for "<%= query %>". Try a different search term.</p>
          </div>
        <% } else { %>
          <div class="text-center">
            <p>Enter a search term to find news articles.</p>
          </div>
        <% } %>
      </section>

      <!-- Back to Home -->
      <div class="text-center mb-5">
        <a href="/" class="btn btn-outline-primary">← Back to Home</a>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- Sidebar -->
      <aside class="sidebar">
        <!-- New Search -->
        <div class="sidebar-widget mb-4">
          <h3 class="widget-title">New Search</h3>
          <form action="/search" method="GET">
            <div class="mb-3">
              <input type="text" name="q" class="form-control" placeholder="Search news..." value="<%= query %>">
            </div>
            <button type="submit" class="btn btn-primary w-100">Search</button>
          </form>
        </div>

        <!-- Trending Topics -->
        <div class="sidebar-widget mb-4">
          <h3 class="widget-title">Trending Topics</h3>
          <ul class="trending-list">
            <li><a href="/category/Technology">Technology</a></li>
            <li><a href="/category/Sports">Sports</a></li>
            <li><a href="/category/Politics">Politics</a></li>
            <li><a href="/category/Health">Health</a></li>
            <li><a href="/category/Environment">Environment</a></li>
          </ul>
        </div>

        <!-- Newsletter Signup -->
        <div class="sidebar-widget mb-4">
          <h3 class="widget-title">Stay Updated</h3>
          <p>Subscribe to our newsletter for the latest news.</p>
          <form class="newsletter-form">
            <div class="mb-3">
              <input type="email" class="form-control" placeholder="Enter your email">
            </div>
            <button type="submit" class="btn btn-primary w-100">Subscribe</button>
          </form>
        </div>

        <!-- Ad Space -->
        <div class="sidebar-widget">
          <div class="ad-placeholder">
            <p class="text-center text-muted">Advertisement</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
