<div class="admin-container">
  <div class="admin-header">
    <h1 class="admin-title">Article Management</h1>
    <div class="admin-actions">
      <a href="/admin/articles/create" class="btn btn-primary">
        <i class="fas fa-plus"></i> New Article
      </a>
    </div>
  </div>

  <div class="admin-filters">
    <form action="/admin/articles" method="GET" class="filter-form">
      <select name="status" class="form-select">
        <option value="">All Status</option>
        <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
        <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
      </select>
      <select name="category" class="form-select">
        <option value="">All Categories</option>
        <option value="Technology" <%= filters.category === 'Technology' ? 'selected' : '' %>>Technology</option>
        <option value="Politics" <%= filters.category === 'Politics' ? 'selected' : '' %>>Politics</option>
        <option value="Science" <%= filters.category === 'Science' ? 'selected' : '' %>>Science</option>
        <option value="Health" <%= filters.category === 'Health' ? 'selected' : '' %>>Health</option>
        <option value="Sports" <%= filters.category === 'Sports' ? 'selected' : '' %>>Sports</option>
        <option value="Entertainment" <%= filters.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
      </select>
      <div class="search-box">
        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Search articles..." class="form-control">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-search"></i>
        </button>
      </div>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>
            <input type="checkbox" class="select-all-checkbox">
          </th>
          <th>Title</th>
          <th>Author</th>
          <th>Category</th>
          <th>Status</th>
          <th>Views</th>
          <th>Last Updated</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% articles.forEach(function(article) { %>
          <tr data-id="<%= article._id %>">
            <td>
              <input type="checkbox" class="article-checkbox" value="<%= article._id %>">
            </td>
            <td>
              <div class="article-info">
                <% if (article.image) { %>
                  <div class="article-thumbnail">
                    <img src="<%= article.image %>" alt="<%= article.title %>">
                  </div>
                <% } %>
                <div class="article-details">
                  <a href="/article/<%= article._id %>" target="_blank" class="article-title"><%= article.title %></a>
                  <div class="article-meta">
                    <% if (article.featured) { %>
                      <span class="badge badge-featured">Featured</span>
                    <% } %>
                    <% if (article.scheduledPublishDate) { %>
                      <span class="badge badge-scheduled">Scheduled</span>
                    <% } %>
                  </div>
                </div>
              </div>
            </td>
            <td>
              <%= article.author ? article.author.username : 'Unknown' %>
              <div class="text-muted">
                <%= article.lastEditedBy ? `Last edited by ${article.lastEditedBy.username}` : '' %>
              </div>
            </td>
            <td>
              <span class="badge badge-category"><%= article.category %></span>
            </td>
            <td>
              <span class="status-badge <%= article.published ? 'published' : 'draft' %>">
                <%= article.published ? 'Published' : 'Draft' %>
              </span>
            </td>
            <td>
              <div class="views-count">
                <i class="fas fa-eye"></i>
                <%= article.views || 0 %>
              </div>
            </td>
            <td>
              <div class="date-info">
                <div><%= new Date(article.updatedAt).toLocaleDateString() %></div>
                <small class="text-muted">
                  <%= new Date(article.updatedAt).toLocaleTimeString() %>
                </small>
              </div>
            </td>
            <td>
              <div class="action-buttons">
                <a href="/admin/articles/<%= article._id %>/edit" class="btn btn-sm btn-primary">
                  <i class="fas fa-edit"></i>
                </a>
                <button class="btn btn-sm btn-success toggle-publish" data-id="<%= article._id %>" data-published="<%= article.published %>">
                  <i class="fas <%= article.published ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                </button>
                <button class="btn btn-sm btn-warning toggle-feature" data-id="<%= article._id %>" data-featured="<%= article.featured %>">
                  <i class="fas <%= article.featured ? 'fa-star' : 'fa-star-o' %>"></i>
                </button>
                <button class="btn btn-sm btn-danger delete-article" data-id="<%= article._id %>">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="bulk-actions">
    <select class="form-select" id="bulk-action">
      <option value="">Bulk Actions</option>
      <option value="publish">Publish</option>
      <option value="unpublish">Unpublish</option>
      <option value="feature">Feature</option>
      <option value="unfeature">Unfeature</option>
      <option value="delete">Delete</option>
    </select>
    <button class="btn btn-primary" id="apply-bulk-action" disabled>Apply</button>
  </div>

  <% if (pagination.pages > 1) { %>
    <div class="pagination-container">
      <% for(let i = 1; i <= pagination.pages; i++) { %>
        <a href="/admin/articles?page=<%= i %>&status=<%= filters.status || '' %>&category=<%= filters.category || '' %>&search=<%= filters.search || '' %>"
           class="pagination-link <%= pagination.page === i ? 'active' : '' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Select all checkbox functionality
  const selectAllCheckbox = document.querySelector('.select-all-checkbox');
  const articleCheckboxes = document.querySelectorAll('.article-checkbox');
  const bulkActionSelect = document.getElementById('bulk-action');
  const applyBulkActionBtn = document.getElementById('apply-bulk-action');

  selectAllCheckbox?.addEventListener('change', function() {
    articleCheckboxes.forEach(checkbox => {
      checkbox.checked = this.checked;
    });
    updateBulkActionButton();
  });

  articleCheckboxes.forEach(checkbox => {
    checkbox.addEventListener('change', updateBulkActionButton);
  });

  function updateBulkActionButton() {
    const checkedBoxes = document.querySelectorAll('.article-checkbox:checked');
    applyBulkActionBtn.disabled = checkedBoxes.length === 0;
  }

  // Bulk actions
  applyBulkActionBtn?.addEventListener('click', async function() {
    const action = bulkActionSelect.value;
    if (!action) return;

    const checkedBoxes = document.querySelectorAll('.article-checkbox:checked');
    const articleIds = Array.from(checkedBoxes).map(cb => cb.value);

    try {
      const response = await fetch('/admin/articles/bulk', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ action, articleIds })
      });

      if (!response.ok) throw new Error('Failed to perform bulk action');

      // Refresh the page to show updated data
      window.location.reload();
    } catch (error) {
      console.error('Error performing bulk action:', error);
      showToast('Failed to perform bulk action', 'error');
    }
  });

  // Individual article actions
  document.querySelectorAll('.toggle-publish').forEach(button => {
    button.addEventListener('click', async function() {
      const articleId = this.dataset.id;
      const published = this.dataset.published === 'true';
      
      try {
        const response = await fetch(`/admin/articles/${articleId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ published: !published })
        });

        if (!response.ok) throw new Error('Failed to update article status');

        // Update UI
        this.dataset.published = (!published).toString();
        this.querySelector('i').className = `fas ${!published ? 'fa-eye-slash' : 'fa-eye'}`;
        const statusBadge = this.closest('tr').querySelector('.status-badge');
        statusBadge.textContent = !published ? 'Published' : 'Draft';
        statusBadge.className = `status-badge ${!published ? 'published' : 'draft'}`;
        
        showToast(`Article ${!published ? 'published' : 'unpublished'} successfully`, 'success');
      } catch (error) {
        console.error('Error updating article status:', error);
        showToast('Failed to update article status', 'error');
      }
    });
  });

  document.querySelectorAll('.delete-article').forEach(button => {
    button.addEventListener('click', async function() {
      if (!confirm('Are you sure you want to delete this article?')) return;

      const articleId = this.dataset.id;
      
      try {
        const response = await fetch(`/admin/articles/${articleId}/delete`, {
          method: 'POST'
        });

        if (!response.ok) throw new Error('Failed to delete article');

        // Remove the row from the table
        this.closest('tr').remove();
        showToast('Article deleted successfully', 'success');
      } catch (error) {
        console.error('Error deleting article:', error);
        showToast('Failed to delete article', 'error');
      }
    });
  });

  // Toast notification function
  function showToast(message, type) {
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);

    // Trigger animation
    setTimeout(() => toast.classList.add('show'), 100);
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
});
</script>