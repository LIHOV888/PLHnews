<!-- Hero Section -->
<div class="hero-section mb-5">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
          <% if (news.length > 0) { %>
          <div class="hero-article position-relative">
            <% if (news[0].video) { %>
              <video class="hero-video" controls poster="<%= news[0].image %>">
                <source src="<%= news[0].video %>" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            <% } else { %>
              <img src="<%= news[0].image %>" alt="<%= news[0].title %>" class="hero-image">
            <% } %>
            <div class="hero-overlay">
              <div class="hero-content">
                <span class="hero-category">Breaking News</span>
                <h1 class="hero-title"><%= news[0].title %></h1>
                <p class="hero-summary"><%= news[0].summary %></p>
                <a href="/article/<%= news[0].id %>" class="btn btn-light btn-lg">Read Full Story</a>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  let currentPage = 1;
  const loadMoreBtn = document.getElementById('load-more-btn');

  loadMoreBtn.addEventListener('click', async function() {
    currentPage++;
    loadMoreBtn.disabled = true;
    loadMoreBtn.textContent = 'Loading...';

    try {
      const response = await fetch(`/api/articles?page=${currentPage}&limit=5`);
      const data = await response.json();

      if (data.articles && data.articles.length > 0) {
        const articlesHtml = data.articles.map(article => `
          <div class="news-item mb-4">
            <div class="row">
              <div class="col-md-4">
                <a href="/article/${article.id || article._id}">
                  ${article.video ? `
                    <div class="video-thumbnail position-relative">
                      <video class="news-image" muted poster="${article.image}">
                        <source src="${article.video}" type="video/mp4">
                      </video>
                      <div class="play-icon-overlay">
                        <i class="fas fa-play-circle"></i>
                      </div>
                    </div>
                  ` : `<img src="${article.image}" alt="${article.title}" class="news-image">`}
                </a>
              </div>
              <div class="col-md-8">
                <h3 class="news-title"><a href="/article/${article.id || article._id}">${article.title}</a></h3>
                <p class="news-summary">${article.summary}</p>
                <div class="news-meta">
                  <small class="text-muted views-count">${new Date(article.date).toDateString()} | ${article.views} views</small>
                  <a href="/article/${article.id || article._id}" class="read-more">Read More</a>
                </div>
              </div>
            </div>
          </div>
        `).join('');

        // Insert before the load more button
        const loadMoreContainer = loadMoreBtn.parentElement;
        loadMoreContainer.insertAdjacentHTML('beforebegin', articlesHtml);

        loadMoreBtn.disabled = false;
        loadMoreBtn.textContent = 'Load More News';

        // Hide button if no more articles
        if (data.articles.length < 5) {
          loadMoreBtn.style.display = 'none';
        }
      } else {
        loadMoreBtn.style.display = 'none';
      }
    } catch (error) {
      console.error('Error loading more news:', error);
      loadMoreBtn.disabled = false;
      loadMoreBtn.textContent = 'Load More News';
      alert('Failed to load more news. Please try again.');
    }
  });
});
</script>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="container">
  <div class="row">
    <div class="col-lg-8">
      <!-- Search Form -->
      <section class="search-section mb-4">
        <form action="/search" method="GET" class="d-flex">
          <input type="text" name="q" class="form-control me-2" placeholder="Search news..." value="<%= typeof query !== 'undefined' ? query : '' %>">
          <button type="submit" class="btn btn-primary">Search</button>
        </form>
      </section>

      <!-- Featured Stories -->
      <section class="featured-stories mb-5">
        <h2 class="section-title">Featured Stories</h2>
        <div class="row">
          <% news.slice(1, 4).forEach(article => { %>
            <div class="col-md-4 mb-4">
              <div class="card featured-card h-100">
                <a href="/article/<%= article.id %>">
                  <% if (article.video) { %>
                    <div class="video-thumbnail position-relative">
                      <video class="card-img-top" muted poster="<%= article.image %>">
                        <source src="<%= article.video %>" type="video/mp4">
                      </video>
                      <div class="play-icon-overlay">
                        <i class="fas fa-play-circle"></i>
                      </div>
                    </div>
                  <% } else { %>
                    <img src="<%= article.image %>" class="card-img-top" alt="<%= article.title %>">
                  <% } %>
                </a>
                <div class="card-body">
                  <h5 class="card-title"><a href="/article/<%= article.id %>"><%= article.title %></a></h5>
                  <p class="card-text"><%= article.summary %></p>
                  <small class="text-muted views-count"><%= new Date(article.date).toDateString() %> | <%= article.views %> views</small>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- Latest News -->
      <section class="latest-news">
        <h2 class="section-title">Latest News</h2>
          <% news.slice(4).forEach(article => { %>
          <div class="news-item mb-4">
            <div class="row">
              <div class="col-md-4">
                <a href="/article/<%= article.id %>">
                  <% if (article.video) { %>
                    <div class="video-thumbnail position-relative">
                      <video class="news-image" muted poster="<%= article.image %>">
                        <source src="<%= article.video %>" type="video/mp4">
                      </video>
                      <div class="play-icon-overlay">
                        <i class="fas fa-play-circle"></i>
                      </div>
                    </div>
                  <% } else { %>
                    <img src="<%= article.image %>" alt="<%= article.title %>" class="news-image">
                  <% } %>
                </a>
              </div>
              <div class="col-md-8">
                <h3 class="news-title"><a href="/article/<%= article.id %>"><%= article.title %></a></h3>
                <p class="news-summary"><%= article.summary %></p>
                <div class="news-meta">
                  <small class="text-muted views-count"><%= new Date(article.date).toDateString() %> | <%= article.views %> views</small>
                  <a href="/article/<%= article.id %>" class="read-more">Read More</a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>

        <!-- Load More Button -->
        <div class="text-center mt-4">
          <button id="load-more-btn" class="btn btn-outline-primary btn-lg">Load More News</button>
        </div>
      </section>
    </div>

    <div class="col-lg-4">
      <!-- Sidebar -->
      <aside class="sidebar">
        <!-- Trending Topics -->
        <div class="sidebar-widget mb-4">
          <h3 class="widget-title">Trending Topics</h3>
          <ul class="trending-list">
            <li><a href="/category/Technology">Technology</a></li>
            <li><a href="/category/Sports">Sports</a></li>
            <li><a href="/category/Politics">Politics</a></li>
            <li><a href="/category/Health">Health</a></li>
            <li><a href="/category/Environment">Environment</a></li>
          </ul>
        </div>

        <!-- Newsletter Signup -->
        <div class="sidebar-widget mb-4">
          <h3 class="widget-title">Stay Updated</h3>
          <p>Subscribe to our newsletter for the latest news.</p>
          <form class="newsletter-form">
            <div class="mb-3">
              <input type="email" class="form-control" placeholder="Enter your email">
            </div>
            <button type="submit" class="btn btn-primary w-100">Subscribe</button>
          </form>
        </div>

        <!-- Ad Space -->
        <div class="sidebar-widget">
          <div class="ad-placeholder">
            <p class="text-center text-muted">Advertisement</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
